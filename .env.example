# Copia este archivo como ".env" y llena los valores.
# En Vercel: Project → Settings → Environment Variables (los mismos nombres).

# Firebase (Consola de Firebase → Configuración del proyecto → Tus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (subida de fotos, preset "unsigned")
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# (Opcional, solo para migrar) Proyecto de Firebase ANTERIOR del que se copian los datos.
# Después de migrar, bórralas.
VITE_OLD_FIREBASE_API_KEY=
VITE_OLD_FIREBASE_AUTH_DOMAIN=
VITE_OLD_FIREBASE_PROJECT_ID=
VITE_OLD_FIREBASE_APP_ID=

# Plataforma
VITE_PLATFORM_NAME=Catálogos Pro
# La página principal "/" muestra tu portafolio. Si prefieres mostrar un catálogo, pon su enlace:
VITE_HOME_TENANT=
# Correo(s) del super administrador, separados por coma.
# Debe coincidir con el correo escrito en firestore.rules
VITE_SUPERADMIN_EMAILS=camilo13369@gmail.com

# ── SOLO en Vercel (no lleva VITE_, nunca llega al navegador) ──
# Permite al super administrador cambiar contraseñas de los clientes.
# Firebase → Configuración del proyecto → Cuentas de servicio → "Generar nueva clave privada".
# Pega el contenido completo del archivo JSON (en una sola línea) o en base64.
FIREBASE_SERVICE_ACCOUNT=

# ── Pagos en línea con Wompi (SOLO en Vercel, sin VITE_) ──
# Wompi → Desarrolladores → Llaves del API y Secretos.
# Usa primero las llaves de pruebas (pub_test_…) y luego las de producción (pub_prod_…).
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# En Wompi → Desarrolladores → "URL de eventos" pon: https://TU-DOMINIO/api/billing/webhook
