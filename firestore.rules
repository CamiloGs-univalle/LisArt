rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Reglas de seguridad de la plataforma de catálogos
//
//  · Cualquiera puede VER un catálogo (productos, textos, diseño).
//  · Solo el dueño de ese catálogo (o el super administrador) puede EDITARLO.
//  · Solo el super administrador crea catálogos, cuentas y cambia el estado/plan.
//
// Publicar: Consola de Firebase → Firestore Database → Reglas → pegar → Publicar
// (o con la CLI: firebase deploy --only firestore:rules)
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ⚠️ Mismo correo que VITE_SUPERADMIN_EMAILS
    function isSuper() {
      return signedIn()
        && request.auth.token.email == 'camilo13369@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    // Dueño = su perfil apunta a este negocio, o el negocio lo tiene como ownerUid
    function isOwnerOf(tenantId) {
      return signedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && profile().tenantId == tenantId)
        || get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid
      );
    }

    function canEdit(tenantId) { return isSuper() || isOwnerOf(tenantId); }

    // ── Negocios ───────────────────────────────────────────
    match /tenants/{tenantId} {
      allow get: if true;                // ver un catálogo
      // La lista completa solo la ve el super admin; cada dueño puede buscar el suyo
      allow list: if isSuper() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, delete: if isSuper();
      // El dueño edita su negocio, pero no su estado, plan ni a quién pertenece
      allow update: if isSuper() || (
        isOwnerOf(tenantId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'plan', 'ownerUid', 'ownerEmail', 'createdAt', 'billing', 'suspendedReason'])
      );

      match /products/{productId} {
        allow read: if true;
        allow write: if canEdit(tenantId);
      }

      match /settings/{docId} {
        allow read: if true;
        allow write: if canEdit(tenantId);
      }

      // Cuentas del negocio: costos, ventas y cotizaciones. PRIVADO (solo el dueño y el super).
      match /private/{docId} {
        allow read, write: if canEdit(tenantId);
      }
      match /sales/{saleId} {
        allow read, write: if canEdit(tenantId);
      }
      match /quotes/{quoteId} {
        allow read, write: if canEdit(tenantId);
      }
    }

    // ── Datos privados de cada negocio ─────────────────────
    // Correo del dueño y plan completo (precio, modelo). El documento público
    // del negocio solo guarda el vencimiento (billing.paidUntil).
    match /accounts/{tenantId} {
      allow read: if canEdit(tenantId);
      allow write: if isSuper();
    }

    // ── Cuentas ────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSuper() || (signedIn() && request.auth.uid == uid);
      // Las cuentas de clientes las crea el super admin. El super admin
      // puede registrar su propio perfil de super administrador.
      allow create, update: if isSuper();
      allow delete: if isSuper();
    }

    // ── Portafolio (página principal): público para leer, solo el super lo edita ──
    match /platform/{docId} {
      allow read: if true;
      allow write: if isSuper();
    }

    // ── Pagos de los planes ─────────────────────────────────
    // Cada dueño ve los pagos de su catálogo; solo el super los registra.
    // (Los pagos de Wompi los confirma el servidor con la cuenta de servicio.)
    match /payments/{paymentId} {
      allow read: if isSuper() || (signedIn() && isOwnerOf(resource.data.tenantId));
      allow write: if isSuper();
    }

    // ── Solicitudes de ayuda ("olvidé mi contraseña") ───────
    // Cualquiera puede crear una (sin sesión), con campos limitados.
    // Solo el super administrador las ve y las resuelve.
    match /tickets/{ticketId} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'email', 'phone', 'message', 'status', 'createdAt'])
        && request.resource.data.type == 'password'
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.email is string && request.resource.data.email.size() > 4 && request.resource.data.email.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.message is string && request.resource.data.message.size() <= 500;
      allow read, update, delete: if isSuper();
    }

    // ── Datos de la primera versión (solo lectura, para importarlos) ──
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuper();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuper();
    }
  }
}
